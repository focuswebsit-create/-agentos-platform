    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "jsdom": "31.0.0",
    "pg": "8.23.1",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
