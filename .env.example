# AgentOS — environment variables (PLACEHOLDERS ONLY)
# Copy to `.env.local` for local development. Never commit real values.
# Company secret keys must never be exposed to the browser (no NEXT_PUBLIC_ prefix for secrets).

# --- P0 (active) -------------------------------------------------------------
# Public base URL used for metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# NOTE: P0's ADMIN_SHELL_PREVIEW flag has been removed. /admin is now gated by a
# real platform-admin check (an active platform_admins row plus AAL2), so there
# is no environment variable that can expose it by being set wrongly.

# --- P1 (active: Supabase Auth + tenancy) ------------------------------------
# Use the Supabase Development project only. Never point these at production.
# Supabase is deprecating the legacy JWT `anon` / `service_role` keys by the end of 2026,
# so this project uses the `sb_publishable_` / `sb_secret_` key model.

# Browser-safe. Resolves to the anon/authenticated role, so RLS always applies.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SERVER-ONLY. Resolves to service_role (BYPASSRLS). Constructed only in
# src/modules/service-role/, and used only by the platform-admin boundary and the
# execution plane (src/modules/runtime/), always with an explicit org filter.
# Never give this a NEXT_PUBLIC_ prefix; never put it in the browser, a model prompt,
# CI logs, a pull request or committed code.
SUPABASE_SECRET_KEY=

# Local verification only: PostgreSQL 16 used by tests/db/ to exercise migrations and RLS.
# This is NOT a Supabase connection string and must never point at a Supabase project.
TEST_DATABASE_URL=postgresql://postgres@127.0.0.1:5432/agentos_test

# --- P3: runtime -------------------------------------------------------------
# Registers the deterministic simulation provider (src/modules/agent-engine/providers/mock.ts).
# Set it in development, CI and previews; NEVER in production. Every simulated
# answer is labelled as one, but a paying customer must never see one.
AGENTOS_ENABLE_MOCK_PROVIDER=

# SERVER-ONLY. Anthropic API key for Claude (src/modules/agent-engine/providers/anthropic.ts).
# Read only by src/config/provider-keys.server.ts; ESLint forbids importing it anywhere
# but the provider implementations. Never NEXT_PUBLIC_ - if NEXT_PUBLIC_ANTHROPIC_API_KEY
# is set the provider refuses to start. Setting this means REAL CHARGES on the account
# that owns the key: an owner decision, not a setup step.
ANTHROPIC_API_KEY=

# Not used yet: durable execution. Runs execute inline (after()) until then.
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=

# SERVER-ONLY. Authenticates the scheduled reservation sweeper
# (/api/internal/sweep-reservations). At least 24 characters; shorter is treated
# as absent and the endpoint 404s. Without it the sweeper never runs, and a
# crashed worker holds its tenant's budget until someone notices - so this is
# required in any deployment that executes runs. vercel.json schedules it every
# 15 minutes; Vercel Cron sends it as `Authorization: Bearer <value>`.
AGENTOS_CRON_SECRET=

# --- P5 (not used yet: billing provider, sandbox first) ----------------------
# BILLING_PROVIDER=                 # e.g. a single selected provider after legal/commercial approval
# BILLING_WEBHOOK_SECRET=           # server-only
