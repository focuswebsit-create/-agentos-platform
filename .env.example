# AgentOS — environment variables (PLACEHOLDERS ONLY)
# Copy to `.env.local` for local development. Never commit real values.
# Company secret keys must never be exposed to the browser (no NEXT_PUBLIC_ prefix for secrets).

# --- P0 (active) -------------------------------------------------------------
# Public base URL used for metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Super Admin UI shell preview. Keep `false` everywhere except a developer's machine.
# There is NO authentication until P1; when false, /admin/* returns 404.
ADMIN_SHELL_PREVIEW=false

# --- P1 (not used yet: Supabase Auth + tenancy) ------------------------------
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=        # server-only, never in browser/LLM/logs

# --- P3 (not used yet: model provider + runtime) -----------------------------
# ANTHROPIC_API_KEY=                # server-only
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=

# --- P5 (not used yet: billing provider, sandbox first) ----------------------
# BILLING_PROVIDER=                 # e.g. a single selected provider after legal/commercial approval
# BILLING_WEBHOOK_SECRET=           # server-only
