# AgentOS — environment variables (PLACEHOLDERS ONLY)
# Copy to `.env.local` for local development. Never commit real values.
# Company secret keys must never be exposed to the browser (no NEXT_PUBLIC_ prefix for secrets).

# --- P0 (active) -------------------------------------------------------------
# Public base URL used for metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# NOTE: P0's ADMIN_SHELL_PREVIEW flag has been removed. /admin is now gated by a
# real platform-admin check (an active platform_admins row plus AAL2), so there
# is no environment variable that can expose it by being set wrongly.

# --- P1 (active: Supabase Auth + tenancy) ------------------------------------
# Use the Supabase Development project only. Never point these at production.
# Supabase is deprecating the legacy JWT `anon` / `service_role` keys by the end of 2026,
# so this project uses the `sb_publishable_` / `sb_secret_` key model.

# Browser-safe. Resolves to the anon/authenticated role, so RLS always applies.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SERVER-ONLY. Resolves to service_role (BYPASSRLS). Used only by
# src/modules/platform-admin/, always with an explicit org filter and an audit record.
# Never give this a NEXT_PUBLIC_ prefix; never put it in the browser, a model prompt,
# CI logs, a pull request or committed code.
SUPABASE_SECRET_KEY=

# Local verification only: PostgreSQL 16 used by tests/db/ to exercise migrations and RLS.
# This is NOT a Supabase connection string and must never point at a Supabase project.
TEST_DATABASE_URL=postgresql://postgres@127.0.0.1:5432/agentos_test

# --- P3 (not used yet: model provider + runtime) -----------------------------
# ANTHROPIC_API_KEY=                # server-only
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=

# --- P5 (not used yet: billing provider, sandbox first) ----------------------
# BILLING_PROVIDER=                 # e.g. a single selected provider after legal/commercial approval
# BILLING_WEBHOOK_SECRET=           # server-only
